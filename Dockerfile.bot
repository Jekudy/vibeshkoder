FROM node:22.19.0-bookworm-slim AS wrangler-runtime

WORKDIR /wrangler
COPY package.json package-lock.json ./
RUN npm ci --omit=dev --ignore-scripts --no-audit --no-fund \
    && node node_modules/wrangler/bin/wrangler.js --version

FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

COPY --from=wrangler-runtime /usr/local/bin/node /usr/local/bin/node
COPY --from=wrangler-runtime /wrangler/node_modules /opt/wrangler/node_modules
RUN /usr/local/bin/node /opt/wrangler/node_modules/wrangler/bin/wrangler.js --version

RUN groupadd --gid 10001 appuser \
    && useradd --uid 10001 --gid appuser --create-home --shell /usr/sbin/nologin appuser

WORKDIR /app
RUN chown appuser:appuser /app

COPY --chown=appuser:appuser requirements.lock .
RUN pip install --no-cache-dir --no-deps -r requirements.lock

COPY --chown=appuser:appuser pyproject.toml .
COPY --chown=appuser:appuser bot/ bot/
COPY --chown=appuser:appuser alembic/ alembic/
COPY --chown=appuser:appuser alembic.ini .
RUN pip install --no-cache-dir --no-deps .

USER appuser

CMD ["sh", "-c", "alembic upgrade head && exec python -m bot"]
