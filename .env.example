BOT_TOKEN=your-bot-token-here
COMMUNITY_CHAT_ID=-1001234567890
ADMIN_IDS=[149820031]
DATABASE_URL=postgresql+asyncpg://vibe:changeme@db:5432/vibe_gatekeeper
REDIS_URL=redis://redis:6379/0
GOOGLE_SHEETS_CREDS_FILE=/app/credentials.json
GOOGLE_SHEET_ID=your-sheet-id
WEB_BASE_URL=http://localhost:8080
WEB_BOT_USERNAME=your_bot_username
DB_PASSWORD=changeme
WEB_PASSWORD=change-me
DEV_MODE=true

# ── Community memory and LLMs ───────────────────────────────────────────────
# Text: DeepSeek V4 Flash is used for QA, extraction, digests, and wiki revisions.
LLM_PROVIDER=deepseek
LLM_MODEL=deepseek-v4-flash
DEEPSEEK_API_KEY=
# Required in production; the application fails closed when it is missing.
LLM_DAILY_USD_CEILING=5.00
LLM_MONTHLY_USD_CEILING=50.00

# Images only. Historical Telegram exports without media files are retained as
# missing_source metadata and are never invented or sent to the vision model.
OPENAI_API_KEY=""
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
EMBEDDING_DAILY_USD_CEILING=1.00
EMBEDDING_MONTHLY_USD_CEILING=10.00
IMAGE_DESCRIPTION_MODEL=gpt-5-nano
IMAGE_DESCRIPTION_DAILY_USD_CEILING=1.00
IMAGE_DESCRIPTION_MONTHLY_USD_CEILING=10.00

# Existing Telegram user used only for durable automatic audit attribution.
MEMORY_AUTOMATION_ACTOR_USER_ID=149820031

# Daily and weekly digests are posted back to the same community chat at 09:00 MSK.
DIGEST_SOURCE_CHAT_ID=-1001234567890
DIGEST_DESTINATION_CHAT_ID=-1001234567890
DIGEST_HOUR_MSK=9
DIGEST_WEEKLY_HOUR_MSK=9
DIGEST_WEEKLY_MINUTE_MSK=0
DIGEST_DAILY_USD_CEILING=1.00
DIGEST_MONTHLY_USD_CEILING=10.00
DIGEST_MIN_CARDS_THRESHOLD=3
DIGEST_RAW_MESSAGE_TOP_N=15
DIGEST_TOKEN_BUDGET_INPUT=8000
DIGEST_WEEKLY_USD_CEILING=5.00
DIGEST_WEEKLY_MONTHLY_USD_CEILING=20.00
DIGEST_WEEKLY_TOKEN_BUDGET=24000
DIGEST_WEEKLY_MIN_CARDS_THRESHOLD=8
DIGEST_WEEKLY_RAW_MESSAGE_TOP_N=60

# ── Static wiki publication (Cloudflare Pages) ───────────────────────────────
# The bot renders into an ephemeral local generation and uploads only audited
# static files. List every VPS hostname/IP here; public deployment refuses an
# empty denylist and the generated CSP has no dynamic backend/API connection.
WIKI_STATIC_PUBLISH_DIR=/tmp/shkoder-wiki-current
WIKI_SITE_TITLE=Shkoder Wiki
WIKI_FORBIDDEN_ORIGINS_JSON=["187.77.98.73","bot.internal.example"]
# Required only when the static wiki publisher is enabled. Keep the token in env;
# the publisher never passes it through argv or persists it in deployment audits.
CLOUDFLARE_API_TOKEN=""
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_PAGES_PROJECT=shkoder-wiki
CLOUDFLARE_PAGES_BRANCH=main
WIKI_PUBLIC_BASE_URL=https://wiki.example.com

# ── Neo4j (Phase 10 graph projection) ────────────────────────────────────────
# Production MUST set NEO4J_AUTH_PASSWORD to a 32+ char rotated value.
# Production MUST use bolt+s:// (TLS); dev default is plaintext bolt://.
NEO4J_BOLT_URI=bolt://neo4j:7687
NEO4J_AUTH_USER=neo4j
NEO4J_AUTH_PASSWORD=test_password_min_32_chars_for_neo4j_5
NEO4J_DATABASE=neo4j

# ── Butler / T12-08 + T12-10 controls ────────────────────────────────────────
# TTL expiry worker interval (seconds). Backlogs drain across ticks.
BUTLER_EXPIRE_TICK_SECONDS=60
# Maximum stale actions processed per tick (prevents pickup-storm after bot downtime).
BUTLER_EXPIRE_BATCH_SIZE=200
# Per-user daily Butler LLM spend ceiling (USD). Separate from global /recall budget.
BUTLER_PER_USER_DAILY_USD_CEILING=0.20
# How long after execution a Butler action can be undone (minutes). T12-07.
BUTLER_UNDO_TTL_MINUTES=60
# Daily total Butler LLM spend ceiling (USD). Covers butler_decision + butler_summary.
BUTLER_DAILY_USD_CEILING=1.00
# Per-action LLM spend ceiling (USD). Abort planning if a single action would exceed.
BUTLER_PER_ACTION_USD_CEILING=0.10
# Monthly total Butler LLM spend ceiling (USD). Covers butler_decision + butler_summary.
BUTLER_MONTHLY_USD_CEILING=10.00
# NOTE: memory.butler.* feature flags live in the feature_flags DB table (not env).
# Seed via SQL: INSERT INTO feature_flags (flag_key, scope_type, scope_id, enabled)
# VALUES ('memory.butler.enabled', NULL, NULL, FALSE), ... (see PHASE12_ROLLOUT.md §9)
